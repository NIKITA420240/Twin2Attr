FROM odsai/ecup26-matching-baseline:1.0

ARG ONNXRUNTIME_VERSION=1.23.2
ARG TENSORRT_VERSION=10.9.0.34

RUN python -m pip install \
    --disable-pip-version-check \
    --no-cache-dir \
    --upgrade \
    "polars==1.43.2" \
    "pymorphy3==2.0.6" \
    "joblib==1.5.3" \
    "loguru==0.7.3" \
    "pint==0.25.3" \
    "orjson==3.11.9" \
    "onnxruntime-gpu==${ONNXRUNTIME_VERSION}" \
    "tensorrt-cu12==${TENSORRT_VERSION}"

RUN python -c "import joblib, loguru, onnxruntime, orjson, pint, polars, pymorphy3, tensorrt; print('ORT providers:', onnxruntime.get_available_providers()); print('TensorRT:', tensorrt.__version__)"
