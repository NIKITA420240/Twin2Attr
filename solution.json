{
  "predictor": "transformer",
  "augmentation_model": null,
  "data_postprocessing_model": null,
  "model_directory": "models\\twin2attr\\qwen3-reranker-4b",
  "transformer_profile": "qwen3_reranker",
  "transformer_head": {
    "type": "native"
  },
  "backend": "adaptive",
  "adaptive_pair_threshold": 10000,
  "batch_size": 512,
  "retry_on_oom": false,
  "dtype": "bfloat16",
  "num_workers": 8,
  "prefetch_factor": 2,
  "pin_memory": true,
  "non_blocking_transfer": true,
  "tokenizer": {
    "batch_fields": {
      "enabled": true,
      "chunk_size": 16384
    }
  },
  "length_bucketing": {
    "enabled": true,
    "padding_length_buckets": [
      32,
      48,
      64,
      80,
      96
    ]
  },
  "torch_compile": {
    "enabled": false,
    "mode": "reduce-overhead",
    "dynamic": true
  },
  "onnxruntime": {
    "provider": "cuda",
    "device_id": 0,
    "io_binding": true,
    "graph_optimization": "all",
    "disabled_optimizers": [
      "Level1_RuleBasedTransformer"
    ],
    "fallback_to_pytorch": false,
    "tensorrt": {
      "engine_cache": {
        "enabled": true,
        "path": "onnx/trt_cache"
      },
      "timing_cache": {
        "enabled": true,
        "path": null
      },
      "profiles": {
        "min_batch_size": 1,
        "opt_batch_size": 512,
        "max_batch_size": 512,
        "sequence_lengths": [
          32,
          64,
          96
        ]
      }
    }
  },
  "tensorrt": {
    "device_id": 0,
    "workspace_size_gb": 8.0,
    "builder_optimization_level": 5,
    "fallback_to_onnxruntime": false,
    "engine_cache": {
      "enabled": true,
      "path": "onnx/native_trt_cache"
    },
    "timing_cache": {
      "enabled": true,
      "path": "onnx/native_trt_cache/timing.cache"
    },
    "profiles": {
      "min_batch_size": 1,
      "opt_batch_size": 512,
      "max_batch_size": 512,
      "sequence_lengths": [
        32,
        64,
        96
      ]
    }
  },
  "onnx_artifacts": {
    "enabled": true,
    "precision": "float8",
    "opset": 19,
    "classifier_path": "onnx/classifier.onnx",
    "encoder_path": null,
    "dynamic_batch": true,
    "dynamic_sequence_length": true
  },
  "features": {
    "execution_order": [
      "normalization",
      "ner",
      "physical"
    ],
    "normalization": {
      "enabled": true,
      "output_column": "normalized_attributes",
      "synonyms_path": "data\\synonyms.parquet",
      "unique_attributes_path": "data\\unique_attributes.parquet",
      "n_jobs": 8,
      "chunk_size": 5000
    }
  }
}
