{
  "predictor": "transformer",
  "augmentation_model": null,
  "data_postprocessing_model": null,
  "model_directory": "models\\twin2attr\\bge-initialized",
  "backend": "pytorch",
  "batch_size": 512,
  "dtype": "bfloat16",
  "num_workers": 8,
  "prefetch_factor": 2,
  "pin_memory": true,
  "non_blocking_transfer": true,
  "tokenizer": {
    "batch_fields": {
      "enabled": true,
      "chunk_size": 16384
    }
  },
  "length_bucketing": {
    "enabled": false,
    "padding_length_buckets": [
      64,
      96,
      128,
      160,
      192,
      224,
      256
    ]
  },
  "torch_compile": {
    "enabled": false,
    "mode": "reduce-overhead",
    "dynamic": true
  },
  "onnxruntime": {
    "provider": "cuda",
    "device_id": 0,
    "io_binding": true,
    "graph_optimization": "all",
    "fallback_to_pytorch": true,
    "tensorrt": {
      "engine_cache": {
        "enabled": true,
        "path": "onnx/trt_cache"
      },
      "timing_cache": {
        "enabled": true,
        "path": null
      },
      "profiles": {
        "min_batch_size": 1,
        "opt_batch_size": 2048,
        "max_batch_size": 2048,
        "sequence_lengths": [
          64,
          96,
          128
        ]
      }
    }
  },
  "tensorrt": {
    "device_id": 0,
    "workspace_size_gb": 8.0,
    "builder_optimization_level": 3,
    "fallback_to_onnxruntime": true,
    "engine_cache": {
      "enabled": true,
      "path": "onnx/native_trt_cache"
    },
    "timing_cache": {
      "enabled": true,
      "path": "onnx/native_trt_cache/timing.cache"
    },
    "profiles": {
      "min_batch_size": 1,
      "opt_batch_size": 512,
      "max_batch_size": 512,
      "sequence_lengths": [
        1,
        256,
        472
      ]
    }
  },
  "onnx_artifacts": {
    "enabled": false,
    "precision": "float16",
    "opset": 18,
    "classifier_path": "onnx/classifier.onnx",
    "encoder_path": "onnx/encoder.onnx",
    "dynamic_batch": true,
    "dynamic_sequence_length": true
  },
  "features": {
    "execution_order": [
      "normalization",
      "ner",
      "physical"
    ],
    "normalization": {
      "enabled": true,
      "output_column": "normalized_attributes",
      "synonyms_path": "data\\synonyms.parquet",
      "unique_attributes_path": "data\\unique_attributes.parquet",
      "n_jobs": 8,
      "chunk_size": 5000
    }
  }
}
